# Copy to .env.local and fill in. Leave both empty to run in LOCAL MODE
# (everything stored in this browser's IndexedDB, no accounts, no cloud sync).
#
# Both values come from Supabase Dashboard -> Project Settings -> API.
# Use the *anon / publishable* key ONLY. NEVER put the service_role key in this
# project: every VITE_* variable is bundled into public JavaScript.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
